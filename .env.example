# ============================================================
# 讲书升级Agent — 环境配置模板
# 使用方式: 复制此文件为 .env，填入你自己的 API Key
# ============================================================

# ========== LLM 配置（脚本生成、选题规划、Agent 决策）==========
# 支持 OpenAI / DeepSeek / 通义千问 等兼容 API
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# DeepSeek 推荐:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat

# ========== 图片生成 API 配置（多 API 池）==========
# 目前使用 API 池模式，支持多个图片 API
# IMAGE_ACTIVE_API=1 表示使用 API 1
IMAGE_ACTIVE_API=1

# API 1: lk888 (GPT-Image 异步接口)
IMAGE_API1_KEY=sk-your-image-api-key
IMAGE_API1_URL=https://api.lk888.ai/v1/media/generate
IMAGE_API1_SIZE=1920x1088

# 图片模型名称（部分 API 需要在请求中指定）
IMAGE_MODEL=gpt-image-2

# ========== 图片生成风格（全局统一）==========
# 此提示词会注入到所有图片生成 prompt 中
IMAGE_STYLE=温馨治愈的插画风格，色彩柔和，适合读书类视频

# ========== 配音配置 ==========
# 可选引擎: edge | minimax | volcano
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 其他中文 Edge-TTS 音色:
#   zh-CN-YunxiNeural (男声，年轻)
#   zh-CN-XiaoyiNeural (女声，温柔)
#   zh-CN-YunjianNeural (男声，稳重)

# ---- 火山引擎 TTS（如 TTS_ENGINE=volcano）----
# 需要注册火山引擎语音合成服务
# VOLCENGINE_TTS_APP_ID=your-app-id
# VOLCENGINE_TTS_ACCESS_TOKEN=your-access-token
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_SPEAKER=zh_male_liufei_uranus_bigtts

# ---- MiniMax TTS（如 TTS_ENGINE=minimax）----
# MINIMAX_API_KEY=your-minimax-key

# ========== 视频配置 ==========
# 横屏 16:9（默认）
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
# 竖屏 9:16 可改为:
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
VIDEO_FPS=24
VIDEO_TRANSITION_DURATION=0.3

# ========== 字幕配置 ==========
SUBTITLE_FONT_PATH=C:/Windows/Fonts/msyh.ttc
SUBTITLE_FONT_SIZE=24
SUBTITLE_BOLD=1
SUBTITLE_MARGIN_V=30
TITLE_FONT_SIZE=36
TITLE_POSITION_Y=200

# ========== 输出目录（可选）==========
# 默认为项目根目录下的 output/
# OUTPUT_DIR=output

# ========== 数据分析仓库路径（可选）==========
# 抖音数据仓库目录，上传和手动拖放的数据文件都在这里
# 默认为项目根目录下的 data_warehouse/
# DATA_WAREHOUSE_DIR=data_warehouse
